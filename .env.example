# ===================================================================
# Polymarket Sports Arbitrage Bot - Configuration Template
# ===================================================================
# Copy this file to .env and fill in your credentials
#
# For $50 test budget, use the CONSERVATIVE settings below
# ===================================================================

# === TRADING MODE ===
# 1 = Paper trading (no real orders), 0 = Live trading
DRY_RUN=1

# === POLYMARKET CREDENTIALS ===
# Get these from your wallet:
# 1. Export private key from MetaMask (must include 0x prefix)
# 2. Your wallet address (must include 0x prefix)
POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
POLY_FUNDER=0xYOUR_WALLET_ADDRESS_HERE

# === KALSHI CREDENTIALS (Optional - for cross-platform arbitrage) ===
# Leave empty if only using Polymarket
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# === LOGGING ===
# RUST_LOG - wie viele Details willst du sehen?
#   error = Nur Fehler (sehr ruhig)
#   warn  = Fehler + Warnungen (ruhig)
#   info  = Normal - zeigt wichtige Events (EMPFOHLEN)
#   debug = Sehr detailliert (für Debugging)
#   trace = Alles (nur für Entwickler)
RUST_LOG=info

# === MARKET DISCOVERY ===
# Categories to monitor (comma-separated): crypto,sports,politics,business
# Default: sports (already configured in code)
ENABLED_CATEGORIES=sports

# Force re-discovery on startup (ignore cache)
FORCE_DISCOVERY=0

# === CIRCUIT BREAKER (RISK MANAGEMENT) ===
# WICHTIG: Schützt dein Geld! Der Bot stoppt automatisch, wenn Limits erreicht werden.

# Enable circuit breaker (IMMER auf 1 lassen!)
CB_ENABLED=1

# ============================================================
# WIE VIEL GELD PRO TRADE?
# ============================================================
# Ein "Contract" kostet zwischen $0.01 und $0.99 (Durchschnitt ~$0.50)
#
# CB_MAX_POSITION_PER_MARKET = Max Contracts in EINEM Market
#   - 10 Contracts = ca. $5 pro Market (bei 50¢ Durchschnittspreis)
#   - 20 Contracts = ca. $10 pro Market
#
# CB_MAX_TOTAL_POSITION = Max Contracts über ALLE Markets zusammen
#   - 50 Contracts = ca. $25 totales Exposure
#   - 100 Contracts = ca. $50 totales Exposure
#
# Für $50 Guthaben SICHER:
CB_MAX_POSITION_PER_MARKET=10
CB_MAX_TOTAL_POSITION=50

# ============================================================
# VERLUST-LIMIT PRO TAG
# ============================================================
# Bot stoppt komplett, wenn dieser Verlust erreicht wird
# Für $50 Budget: Max $10 Verlust = 20% vom Kapital
CB_MAX_DAILY_LOSS=10.0

# ============================================================
# FEHLER-HANDLING
# ============================================================
# Bei 5 Fehlern hintereinander stoppt der Bot (Schutz vor Bugs)
CB_MAX_CONSECUTIVE_ERRORS=5

# Nach einem Stop wartet der Bot 5 Minuten (300 Sekunden)
CB_COOLDOWN_SECS=300

# === ARBITRAGE THRESHOLD ===
# Alert when total cost < this value (lower = higher profit requirement)
# 0.992 = 0.8% minimum profit
# 0.980 = 2.0% minimum profit (more conservative)
ARB_THRESHOLD=0.992

# === MARKET FILTERS ===
# DIESE WERTE SIND SCHON IM CODE GESETZT - nur überschreiben wenn nötig!
#
# Minimum liquidity to consider a market (USD)
# Standard: $100 (findet mehr Markets, auch kleinere)
# MIN_LIQUIDITY_USD=100.0

# Minimum 24h volume to consider a market active (USD)
# Standard: $200 (inkludiert auch ruhigere Markets)
# MIN_VOLUME_24H_USD=200.0

# === ADVANCED (Optional) ===
# Enable verbose price logging (creates lots of output)
PRICE_LOGGING=0

# Inject test arbitrage opportunity (for testing execution logic)
TEST_ARB=0
TEST_ARB_TYPE=poly_yes_kalshi_no

# ===================================================================
# RECOMMENDED SETTINGS FOR DIFFERENT BUDGETS
# ===================================================================
#
# $50 BUDGET (Conservative):
#   CB_MAX_POSITION_PER_MARKET=5
#   CB_MAX_TOTAL_POSITION=25
#   CB_MAX_DAILY_LOSS=5.0
#
# $100 BUDGET (Moderate):
#   CB_MAX_POSITION_PER_MARKET=10
#   CB_MAX_TOTAL_POSITION=50
#   CB_MAX_DAILY_LOSS=10.0
#
# $500 BUDGET (Aggressive):
#   CB_MAX_POSITION_PER_MARKET=25
#   CB_MAX_TOTAL_POSITION=100
#   CB_MAX_DAILY_LOSS=25.0
#
# ===================================================================
